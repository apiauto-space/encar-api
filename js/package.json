{
  "name": "encar-api-client",
  "version": "0.1.1",
  "description": "Encar API client for JavaScript and TypeScript: South Korean used-car listings from Encar as JSON, from the apiauto.space team",
  "keywords": ["encar", "encar-api", "encar.com", "korean-cars", "korea", "used-cars", "car-listings", "vehicle-data", "api-client", "typescript"],
  "homepage": "https://apiauto.space/en/encar-api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apiauto-space/encar-api.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/apiauto-space/encar-api/issues"
  },
  "license": "MIT",
  "author": "apiauto.space (https://apiauto.space/en/)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/client.test.mjs test/live.test.mjs",
    "version": "node scripts/sync-version.mjs && git add src/version.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "apiauto": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
